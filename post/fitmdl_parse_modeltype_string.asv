function fnetspec = fitmdl_parse_modeltype_string(modeltype, chopt, num_dim_indvpre, num_samp_mdl)

%right now order of characters within an underscore doesn't matter, so the code doesn't treat order

% right now channel parsing "works" but the fnet is not optimized for multiple layers, so how channel and layer specification works is not super intuitive

alphabet_caps = char(('A':'Z').').'; %alphabet, capitals, to ensure layer order is corect 

exprlay = cell2mat(chopt.lay);
exprchan = [cell2mat(chopt.chan)];
exprpos = ['^(' exprlay exprchan(2:end-1) ')*$'];
exprunit = cell2mat(chopt.unit); %optional x, optional number (can be multiple digits), one or more non-digit character
exprprefix = cell2mat(chopt.prefix);
exprlin = strjoin(chopt.lin, '|');
exprnon = strjoin(chopt.non, '|');
exprhot = cell2mat(chopt.hot); %h followed by a number followed by one or more optional chars that aren't any of chars in chl, cha, or chh

numchan_total_currlay = num_dim_indvpre; %total for input layer, wll be updated for each layer
layer = 1;
allchan = [];

spl = strsplit(modeltype, '_');
if strcmp(spl{1}, 'fnet')

    tmp = find(~cellfun(@isempty, regexp(spl, exprpos)));

    for si = 1:length(tmp)
        if si==length(tmp)
            specinds{si} = tmp(si):length(spl);
        else
            specinds{si} = tmp(si):tmp(si+1)-1;
        end
    end

    num_specified_positions = numel(specinds);
    for si = 1:num_specified_positions
        strposition = spl{specinds{si}(1)};
        num_substrings = length(specinds{si})-1;
        [strlay, strlayind] = regexp(strposition, alphabet_caps(layer), 'match');
        strlay = cell2mat(strlay);
        exprlay_all = ['[' alphabet_caps(1:layer) ']' ];
        if numel(regexp(strposition, exprlay_all, 'match'))~=layer
            error("not all previous layers appear in position string")
        end
        if ~strcmp(cell2mat(regexp(strposition, exprlay_all, 'match')), alphabet_caps(1:layer) )
            error("all previous layers must appear in alphabetical order in position string")
        end

        if strlayind+1>numel(strposition)
            channel = 1:numchan_total_currlay;
        else
            strposition_currchanonly = strposition(strlayind+1:end);
            if isempty(regexp(strposition_currchanonly, '^\d*(\d-\d+)*$', 'match'))
                error("invalid channel string")
            end
            str_chanrange = regexp(strposition_currchanonly, '(\d-\d)*', 'match');
            chanrange = [];
            chanrange_chars = {};
            for cri = 1:numel(str_chanrange)
                if numel(str_chanrange{cri})~=3
                    error("incorrect channel range spec")
                end
                chanrange = [chanrange str2double(str_chanrange{cri}(1)):str2double(str_chanrange{cri}(3))];
                chanrange_chars(end+1) = {str_chanrange{cri}(1)}; 
                chanrange_chars(end+1) = {str_chanrange{cri}(3)}; 
            end
            if numel(unique(chanrange))~=numel(chanrange)
                error("duplicate channels in range spec")
            end
            str_chan_allchars = regexp(strposition_currchanonly, '\d{1}', 'match');
            if numel(unique(str_chan_allchars))~=numel(str_chan_allchars)
                error("duplicate channels")
            end
            str_chan_notrange = setxor(str_chan_allchars, chanrange_chars);
            chan_notrange = str2double(str_chan_notrange);
            channel = unique([chan_notrange, chanrange]);
        end

        allchan = [allchan channel];

        spec_oneposition = [];
        for ni = 1:num_substrings

            strunit = spl{specinds{si}(ni+1)};
            if isempty(regexp(strunit, exprunit, 'match')) || strcmp(regexp(strunit, '^x*\d*\D', 'match'), 'x') %str is invalid if it doesn't match, exprunit, or it matches but only because it contains only x and a number (invalid case that nevertheless matches exprunit)
                error("unit string invalid syntax, must be: optional x, optional number (can be multiple digits), one or more non-digit character")
            end

            if strcmp(strunit(1), 'x')
                combo_spec = 1;
                disp("making all combinations of linear and nonlinear function specifiers")
            else
                combo_spec = 0;
            end

            [strprefix, indsprefix] = regexp(strunit, exprprefix, 'match', 'once'); %first occurrence of optional x and or optional number
            strprefix = {strprefix};

            num_units_for_this_substring = str2double(cell2mat(regexp(cell2mat(strprefix), '\d*', 'match'))); %any number in the prefix, can be multi-digit (checks above ensures only one number appears in unit string)
            if isnan(num_units_for_this_substring)
                num_units_for_this_substring = 1;
            end

            [strlin, indslin] = regexp(strunit, exprlin, 'match');
            if combo_spec && numel(unique(strlin)) ~= numel(strlin)
                error("there are duplicate linear function chars within a single unit string that is specified combo style (with x prefix)")
            end
            [strnon_nothot, indsnothot] = regexp(strunit, exprnon, 'match');
            if combo_spec && numel(unique(strnon_nothot)) ~= numel(strnon_nothot)
                error("there are duplicate (not hot) nonlinear function chars within a single unit string that is specified combo style (with x prefix)")
            end
            [strhot, indshot] = regexp(strunit, exprhot, 'match');
            if combo_spec && numel(unique(strhot)) ~= numel(strhot)
                error("there are duplicate one-hot encoding function chars within a single unit string that is specified combo style (with x prefix)")
            end
            if ~isempty(regexp('x3h1h16sh0', 'h\D', 'match')) %if there are any h followed by non-numeric char
                error("one hot encoding string must be h followed by number")
            end
            if numel(strlin)>1 && ~combo_spec
                error("only one linear function allowed (for now), unless specifying a combo (x prefix)")
            end
            if num_samp_mdl>0 && isempty(strlin)
                error("missing linear function specifier for multi-timepoint model; curently no available nonlinear functions accept multi-timepoint input")
            end

            total_num_function_strings = length(strlin) + length(strnon_nothot) + length(strhot); %hot strings have multiple chars, all others have one

            if combo_spec
                strnon = [strnon_nothot strhot];
                spec_onesubstring = combinations(strlin, strnon);
            else
                newspec(indsprefix) = strprefix;
                newspec(indslin) = strlin;
                newspec(indsnothot) = strnon_nothot;
                newspec(indshot) = strhot;
                newspec = newspec(~cellfun(@isempty, newspec));
                if ~strcmp(cell2mat(newspec), strunit)
                    error("reconstructed unit string does not match original")
                end
                newspec(indsprefix) = [];
                spec_onesubstring = cell2table(newspec);
                clear newspec
            end

            fun = table2cell(spec_onesubstring);
            spec_onesubstring = cell2table(fun);

            spec_onesubstring = repmat(spec_onesubstring, [num_units_for_this_substring 1]);
            if ni==1
                spec_oneposition = spec_onesubstring;
            else
                spec_oneposition = outerjoin(spec_oneposition, spec_onesubstring, 'MergeKeys', true); %cat spec from each parsed underscore-delimited substring
            end

        end

        layerfield = ['L' num2str(layer)];
        for ci = 1:length(channel)
            channelfield = num2str(channel(ci));
            fnetspec.(layerfield).(channelfield) = spec_oneposition;
        end

        if max(allchan)>numchan_total_currlay
            error("exceeded max number channels for this layer")
        end
        if isequal(allchan, 1:numchan_total_currlay)
            layer = layer+1;
            numchan_total_currlay = max(allchan);
            allchan = [];
        end

    end

end