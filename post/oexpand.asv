function o = oexpand(o, vbin)

arguments
    o
    vbin
end

if ~iscell(vbin)
    vbin = {vbin};
end

for j = 1:numel(o)
    for k = 1:numel(vbin)
        vbintmp = o(j).(vbin{k});
        fn = fieldnames(vbintmp);
        alltmp = struct;
        for m = 1:numel(fn)
            copybintmp = vbintmp.(fn{m});
            optflat = structflat(copybintmp, prefix=fn{m});
            fnflat = fieldnames(optflat);
            % if any(~cellfun(@isempty, regexp(fnflat,'_[\d]*_')))
            %     error("cannot use nonscalar structs in o")
            % end

            fnnew = [fn{m} '_' num2str(1)];
            tmp = [];
            tmp.(fnnew) = struct;
            expandinds = zeros(numel(fnflat), 1, 'logical');
            for p = 1:numel(fnflat)
                tmpset = fieldnames(tmp);
                numset = numel(tmpset);
                if iscell(optflat.(fnflat{p})) && numel(optflat.(fnflat{p}))>1
                    expandinds(p) = 1;
                    for w = 1:numel(optflat.(fnflat{p}))
                        for ww = 1:numset
                            newind = ww+numel(numset)*(w-1);
                            fnnew = [fn{m} '_' num2str(newind)];
                            tmp.(fnnew).(fnflat{p}) = optflat.(fnflat{p}){w};
                        end
                    end
                end
            end
            tmpset = fieldnames(tmp);
            numset = numel(tmpset);
            for p = 1:numel(fnflat)
                if ~expandinds(p)
                    for ww = 1:numset
                        fnnew = [fn{m} '_' num2str(ww)];
                        if iscell(optflat.(fnflat{p}))
                            tmp.(fnnew).(fnflat{p}) = optflat.(fnflat{p}){1}; %since singleton, take it out of cell
                        else
                            tmp.(fnnew).(fnflat{p}) = optflat.(fnflat{p});
                        end
                    end
                end
            end

            alltmp = cell2struct([struct2cell(alltmp); struct2cell(tmp)], [fieldnames(alltmp); fieldnames(tmp)]); %combine

            alltmp = fieldord(alltmp);


            fntmp = fieldnames(alltmp);
            pthopt = '~/stacks/optroi.txt';
            fid = fopen(pthopt, 'a+');
            tmpout = fread(fid, "*char")';
            newopts = 0;
            for p = 1:numel(fntmp)
                if isempty(tmpout)
                    optfile = struct;
                else
                    optfile = jsondecode(tmpout);
                end
                fnfile = fieldnames(optfile);
                optindnum = cellfun(@str2double, cellflat(regexp(fnfile,'\d+','match')));
                if numel(optindnum)~=numel(fnfile)
                    error("there should be one integer per optind, you may have an optind with an invalid name; name should be i followed by an integer")
                end
                if isempty(optindnum)
                    fnfilenew = ['i' num2str(p)];
                    optfile.(fnfilenew) = alltmp.(fntmp{p});
                else
                    maxoptind = max(optindnum);
                    for w = 1:numel(fnfile)
                        if w==numel(fnfile) && ~isequal(alltmp.(fntmp{p}), optfile.(fnfile{w})) %if current options don't match any in the roiopt file, append them to end as new option set
                            fnfilenew = ['i' num2str(maxoptind+1)];
                            maxoptind.(fnfilenew) = alltmp.(fntmp{p});
                        end
                    end
                end

            end
            if newfile || newopts
                txt = jsonencode(alltmp, PrettyPrint=true);
                %remove white-spaces inside vectors and matrices
                txt = regexprep(txt,',\s+(?=\d)',','); % , white-spaces digit
                txt = regexprep(txt,',\s+(?=-)',','); % , white-spaces minussign
                txt = regexprep(txt,'[\s+(?=\d)','['); % [ white-spaces digit
                txt = regexprep(txt,'[\s+(?=-)','['); % [ white-spaces minussign
                txt = regexprep(txt,'(?<=\d)\s+]',']'); % digit white-spaces ]
                fprintf(fid,'%s',txt);
            end
            fclose(fid);

        end

    end

end








