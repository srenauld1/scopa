function o = oexpand(o, vbin)

arguments
    o
    vbin
end


for j = 1:numel(o)
    for k = 1:numel(vbin)
        vbintmp = o(j).(vbin{k});
        fn = fieldnames(vbintmp);
        for m = 1:numel(fn)
            copybintmp = vbintmp.(fn{w});
            opts = fieldnames(copybintmp);
            for p = 1:numel(opts)

                if iscell(opts{p})
                    for w = 1:numel(opts{p})
                        oa.(vbintmp).(fn{w}) = opts{p}{w};
                    end
                else

                end
            end
        end

    end

end








