function [objfcn, lbnd, ubnd, linineq_A, linineq_b, ...
    x0, supp, gethue, gethr_native] = ...
    fit_glno(modeltype, stim, resp, num_samp_model, num_dim_stimin, huestr)



% create excitatory and inhibitory LNs with constraints on horizontal
% asymptotes of sigmoid (while constraining slope to be positive always)


if strcmp(modeltype, 'glno')
    objfcn = @ann;
elseif strcmp(modeltype, 'glno2')
    objfcn = @ann2;
elseif strcmp(modeltype, 'glno3')
    objfcn = @fit_ann;
    polarity_types_per_stim_dim = {'excitatory', 'inhibitory'}; %excitatory (positive slope sigmoid) as opposed to inhibitory (negative slope sigmoid)
    linfilt_types_per_stim_dim = {'integrating', 'differentiating'}; %integrator (monophasic linear filter) as opposed to differentiator (biphasic linear filter)
    nonlinearity_types_per_stim_dim = {'none'}; %'none' to skip, 'genlog' for 5-param sigmoid
elseif strcmp(modeltype, 'glno4')
    objfcn = @fit_ann;
    polarity_types_per_stim_dim = {'excitatory', 'inhibitory'}; %excitatory (positive slope sigmoid) as opposed to inhibitory (negative slope sigmoid)
    linfilt_types_per_stim_dim = {'differentiating'}; %integrator (monophasic linear filter) as opposed to differentiator (biphasic linear filter)
    nonlinearity_types_per_stim_dim = {'none'}; %'none' to skip, 'genlog' for 5-param sigmoid
elseif strcmp(modeltype, 'glno5')
    objfcn = @fit_ann;
    polarity_types_per_stim_dim = {'excitatory', 'inhibitory'}; %excitatory (positive slope sigmoid) as opposed to inhibitory (negative slope sigmoid)
    linfilt_types_per_stim_dim = {'differentiating'}; %integrator (monophasic linear filter) as opposed to differentiator (biphasic linear filter)
    nonlinearity_types_per_stim_dim = {'none'}; %'none' to skip, 'genlog' for 5-param sigmoid
end


LN_specs_per_stim_dim = combinations(polarity_types_per_stim_dim, linfilt_types_per_stim_dim);

num_LN_per_stimdim = size(LN_specs_per_stim_dim, 1);
num_LN_total = num_LN_per_stimdim*num_dim_stimin;
minstim = min(stim(:));
maxstim = max(stim(:));


%% define all possible params for single LN (some will not be used, depending on LN type)

% 3-element vectors below are [lowerbound, upperbound, startpoint]
tau1 = [0.1, 2, 0.5];
tau2 = [0.1, 2, 0.5]; %fraction by which tau2 is larger than tau1 (better behaved)
filtshift = [0, 3, 0.01];   %linear interpolation time shift
tc = [0, 1, 0.1]; %L1 norm of tau2 filter, redundant with filtnorm somewhat, so make filtnorm constant 
filtnorm = [-inf, inf, 1]; %L1 norm of whole filter (tau1 filter minus tau2 filter, assuming latter is not norm zero )
sigmoid_slope = [0, inf, 1];  %force positive, letting left/right asymptotes determine sign without redundancy from slope (no constraint that left must be greater than right)
sigmoid_asympleft = [-inf, inf, min(resp(:))]; 
sigmoid_asympright = [-inf, inf, max(resp(:))]; 
sigmoid_inflection = [0, inf, 1]; %must be positive 
sigmoid_xshift = [minstim, maxstim, mean([minstim maxstim])];  %since filtnorm is forced to be 1, filter output will be on order of stim

%% 


lbnd = [];
ubnd = [];
x0 = [];
linineq_min_difference = 0; %zero allows equality, could try -2*options.ConstraintTolerance instead of zero (why -2, why not just -options.ConstraintTolerance?)
LN_ind_total = 0;
num_par_running_total = 0;
for jj = 1:num_dim_stimin
    for ii = 1:num_LN_per_stimdim
        
        LN_ind_total = LN_ind_total + 1;

        if strcmp(LN_specs_per_stim_dim.linfilt_types_per_stim_dim(ii), 'integrating') %makes monophasic filter, 2 params
            lbnd_lin = [tau1(1), filtshift(1)];
            ubnd_lin = [tau1(2), filtshift(2)];
            x0_lin = [tau1(3), filtshift(3)];
        elseif strcmp(LN_specs_per_stim_dim.linfilt_types_per_stim_dim(ii), 'differentiating') %makes biphasic filter, 4 params, ie includes params for 2nd filter (constrained to be slower), subtracted from first
            lbnd_lin = [tau1(1), filtshift(1), tau2(1), tc(1)];
            ubnd_lin = [tau1(2), filtshift(2), tau2(2), tc(2)];
            x0_lin = [tau1(3), filtshift(3), tau2(3), tc(3)];
        end

        lbnd_nonlin = [sigmoid_slope(1), sigmoid_asympleft(1), sigmoid_asympright(1), sigmoid_inflection(1), sigmoid_xshift(1)];
        ubnd_nonlin = [sigmoid_slope(2), sigmoid_asympleft(2), sigmoid_asympright(2), sigmoid_inflection(2), sigmoid_xshift(2)]; 
        x0_nonlin = [sigmoid_slope(3), sigmoid_asympleft(3), sigmoid_asympright(3), sigmoid_inflection(3), sigmoid_xshift(3)]; 


        num_par_this_LN = length(lbnd_lin)+length(lbnd_nonlin);
        parind_this_LN = [1:num_par_this_LN] + num_par_running_total;
        num_par_running_total = num_par_running_total + num_par_this_LN;
        pind{jj,ii}.L = parind_this_LN(1:length(lbnd_lin));
        pind{jj,ii}.N = parind_this_LN(length(lbnd_lin)+1:end);

        linineq_A_tmp = zeros(1, num_par_this_LN);
        if  strcmp(LN_specs_per_stim_dim.polarity_types_per_stim_dim(ii), 'excitatory')  %left asymptote <= right asymptote will make positive slope (assuming slope param constrained positive) but we want strictly less than (right?), so modify linineq_b to not be zero?
            linineq_A_tmp(length(lbnd_lin)+2) = 1;
            linineq_A_tmp(length(lbnd_lin)+3) = -1;
        elseif strcmp(LN_specs_per_stim_dim.polarity_types_per_stim_dim(ii), 'inhibitory')  %right asymptote <= left asymptote will make negative slope (assuming slope param constrained positive) but we want strictly less than (right?), so modify linineq_b to not be zero?
            linineq_A_tmp(length(lbnd_lin)+2) = -1;
            linineq_A_tmp(length(lbnd_lin)+3) = 1;
        end


        lbnd = [lbnd lbnd_lin lbnd_nonlin];
        ubnd = [ubnd ubnd_lin ubnd_nonlin];
        x0 = [x0 x0_lin x0_nonlin];
        linineq_A(LN_ind_total, parind_this_LN) = linineq_A_tmp;
        linineq_b(LN_ind_total) = 0 + linineq_min_difference;

    end
end


supp.num_par_total = length(lbnd);
supp.num_LN_per_stimdim = num_LN_per_stimdim;
supp.num_LN_total = num_LN_total;
supp.LN_specs_per_stim_dim = LN_specs_per_stim_dim;
supp.num_dim_stim = num_dim_stimin;
supp.num_samp_model = num_samp_model;
supp.pind = pind;
supp.num_model_functions = 2;

%% make sure doubles 

lbnd = double(lbnd);
ubnd = double(ubnd);
x0 = double(x0);
linineq_A = double(linineq_A);
linineq_b = double(linineq_b);

%% params for plots 

switch huestr
    case 'loc'
        gethue = @(ft, st, pr) st(find(max(pr) == pr, 1)); %value of stim at max predicted response; doing this instead of just ft(3) because ft(3) is preferred head direction when ft(1)*ft(2) is positive, but null head direction when negative, and mse is worse with bounds that force nonnegative
        gethr_native = @(ft,st,rs) [0 2*pi];
    case 'wid'
        gethue = @(ft, st, pr) 2 * abs( acos( 1/ft(2) * log( 1/2 *( exp(ft(2)) + exp(-ft(2)) ))));
        gethr_native = @(ft,st,rs) [0 2*pi];
    case 'amp'
        gethue = @(ft, st, pr) ft(1) * ( exp(ft(2)) - exp(-ft(2)) );
        gethr_native = @(ft,st,rs) [min(rs(:)) max(rs(:))];
end


