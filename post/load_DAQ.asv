function [daqdata_resamp, ti, ball, vis] = load_DAQ(ids, numslice, numvol, ...
    numslice_withflyback, dtmni, ball_diameter, pth_daq, pth_daq_resamp, ...
    discard_flyback_frames, slopelen_sec, slopeorder)

% using movingslope to extract velocity (can increase slopelen_sec to reduce noise)
% with this there is no need for smoothing first
% for circular variables, operating on x and y components

daqvars.normal = {'Time', 'heat'};
daqvars.circular = {'ficTracIntSide', 'ficTracIntForward', 'ficTracYaw', 'g4panels'};
daqvars.categorical = {'virmenFrameClock'};
daqvars.scale_by_ball_diameter = {'ficTracIntSide', 'ficTracIntForward'};

ball = [];
vis = [];

minvolt = 0; %need to find this in metadata
maxvolt = 10; %need to find this in metadata

try

    fool=mool
    load(pth_daq_resamp, 'daqdata_resamp')

catch


    %% load daqdata

    load(pth_daq, 'trialData')

    trialData = timetable2table(trialData);

    %% define inds for downsampling

    if any(strcmp(trialData.Properties.VariableNames, 'ffframeClock'))
        sliceinds = binary2count(trialData.frameClock);
        flyback_frames = numslice+1:numslice_withflyback;
        numvol_from_frames = max(sliceinds)/numslice_withflyback;
        if numvol_from_frames~=numvol
            error("number of volumes computed from daq frames does not match number of stack volumes")
        end
        sliceinds(sliceinds==0) = nan; %make zeros nan before mod
        sliceinds = mod(sliceinds-1, numslice_withflyback)+1; %get one-indexed slice indices
        if discard_flyback_frames
            sliceinds(ismember_each_element(sliceinds, flyback_frames)) = 0; %make flyback frames zero
            sliceinds(isnan(sliceinds)) = 0; %return nan to zero
        end
    else
        sprintf("frame clock not on daq, downsampling daq data with 'resample' function, rather averaging during frames")
        sliceinds = [];
    end


    %% make/save resampled daqdata

    uniquesliceinds = unique(sliceinds(sliceinds~=0));
    num_unique_sliceinds = numel(uniquesliceinds);
    num_resamples = num_unique_sliceinds + 1; %resample for each frame, and add one for volume
    daqdata_resamp = table();
    for si = 1:num_resamples

        newrow = table();
        newrow.datenum = {ids.datenum};
        newrow.flynum = {ids.flynum};
        newrow.trialnum = {ids.trialnum};
        if isempty(sliceinds)
            resample_inds = [];
            newrow.sliceindex = {'volume'};
        else
            if si<num_unique_sliceinds+1
                resample_inds = binary2count(sliceinds==uniquesliceinds(si)); %each slice
                newrow.sliceindex = {uniquesliceinds(si)};
            else
                resample_inds = ceil(binary2count(logical(sliceinds))/num_unique_sliceinds); %all slices (the whole volume)
                newrow.sliceindex = {'volume'};
            end
        end

        fn = fieldnames(daqvars);
        for fni = 1:numel(fn)
            daqvartypes = fn{fni};
            for ii = 1:numel(daqvars.(daqvartypes))
                scale_by_ball_diameter = any(strcmp(daqvars.scale_by_ball_diameter, daqvars.(daqvartypes){ii}));
                daqts = trialData.(daqvars.(daqvartypes){ii});
                if ~strcmp(trialData.Properties.VariableNames, daqvars.(daqvartypes){ii})
                    sprintf("warning, daq does not have variable named " + daqvars.(daqvartypes){ii} + ", skipping it")
                [ newrow.(daqvars.(daqvartypes){ii}), newrow.([daqvars.(daqvartypes){ii} '_diff']) ] = process_DAQ_signal(daqvartypes, daqts, numvol, resample_inds, dtmni, maxvolt, slopelen_sec, slopeorder, ball_diameter, scale_by_ball_diameter);
            end
        end
        daqdata_resamp = [daqdata_resamp; newrow];
    end

    save(pth_daq, 'daqdata_resamp');

end


ball.yaw = daqdata_resamp.ficTracYaw{1};
ball.yawvel = daqdata_resamp.ficTracYaw_diff{1};
ball.intfor = daqdata_resamp.ficTracIntForward{1};
ball.forvel = daqdata_resamp.ficTracIntForward_diff{1};
ball.intside = daqdata_resamp.ficTracIntSide{1};
ball.sidevel = daqdata_resamp.ficTracIntSide_diff{1};

vis.ang = daqdata_resamp.g4panels{1};
vis.angvel = daqdata_resamp.g4panels_diff{1};

ti = daqdata_resamp.Time{:};


