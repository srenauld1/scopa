function [axx, axy, axw, axh] = arrange_subplots(numrows, numcolumns, margins_fig, margins_subfig, splitdim, splitfrac)

arguments
    numrows double %scalar or vector; if vector, element index refers to sector of figure; sector split by splitdim;
    numcolumns double %scalar or vector; if vector, element index refers to sector of figure; sector split by splitdim;
    margins_fig double = 0.03 %scalar or vector; if vector, element index refers to sector of figure; sector split by splitdim;
    margins_subfig double = 0.03 %scalar or vector; if vector, element index refers to sector of figure; sector split by splitdim;
    splitdim char = 'h' %scalar char; h for horizontal split (left-right), v for vertical split (top-bottom)
    splitfrac double = repelem(1/numel(numrows), numel(numrows)-1) %scalar or vector denoting each sector's fraction of splitdim extent; default is even split among num_sectors
end

num_sectors = numel(numrows);

if isempty(margins_fig) %allow empty
    margins_fig = repelem(0.03, num_sectors);
end
if numel(margins_fig)==1 && num_sectors~=1 %allow singleton to be repeated to match num_sectors
    margins_fig = repelem(margins_fig, num_sectors);
end
if isempty(margins_subfig) %allow empty
    margins_subfig = repelem(0.03, num_sectors);
end
if numel(margins_subfig)==1 && num_sectors~=1 %allow singleton to be repeated to match num_sectors
    margins_subfig = repelem(margins_subfig, num_sectors);
end
if ~isequal(numel(numrows), numel(numcolumns), numel(margins_fig), numel(margins_subfig), numel(splitfrac)+1)
    error("length must be same for numrows, numcolumns, margins_fig, margins_subfig, splitfrac")
end



for j = 1:num_sectors

    [axx_tmp{j}, axy_tmp{j}, axw_tmp{j}, axh_tmp{j}] = arrange_subplots_onesector(numrows(j), numcolumns(j), margins_fig(j), margins_subfig(j));

    if j==2
        axw_tmp{j} = axw_tmp{j}*(1-splitfrac(j-1))-margins_subfig(j);
        axx_tmp{j} = axx_tmp{j} + max(axx_tmp{j-1})+unique(axw_tmp{j-1})+margins_subfig(j);
    end
end

axx = cell2mat(axx_tmp);
axy = cell2mat(axy_tmp);
axw = cell2mat(axw_tmp);
axh = cell2mat(axh_tmp);

end


function [axx, axy, axw, axh] = arrange_subplots_onesector(numrows, numcolumns, margins_fig, margins_subfig)

minx = 0+margins_subfig+margins_fig;
maxx = 1-margins_subfig-margins_fig;

axx = linspace( minx, maxx, numcolumns+1 ) ;
axx = axx(1:end-1); %xposition including labels (outer position)

axwlab = maxx - axx(end); %width including labels
axw = axwlab - margins_subfig;


miny = 0+margins_subfig+margins_fig;
maxy = 1-margins_subfig-margins_fig;

axy = linspace( miny, maxy, numrows+1 ) ;
axy = axy(1:end-1); %xposition including labels (outer position)

axhlab = maxy - axy(end); %width including labels
axh = axhlab - margins_subfig;


axy = flip(axy); %make y order top to bottom


[p,q] = meshgrid(axx, axy);
tmp = [p(:) q(:)];

axx = tmp(:,1);
axy = tmp(:,2);

axw = vec(repelem(axw, numel(axx)));
axh = vec(repelem(axh, numel(axx)));

end