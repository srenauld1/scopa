function ax = arrange_subplots(numrows, numcolumns, margins_fig, margins_subfig, splitdim, splitfrac)

% find xy position and extent of subplots 
% can split figure into sectors along x or y (not both yet); sectors can have different subplot arrangements 
% output ax is struct, where each element is sector, and each field is x or y position or extent 

arguments
    numrows double %scalar or vector; element n denotes number of rows in sector n; 
    numcolumns double %scalar or vector; element n denotes number of columns in sector n; 
    margins_fig double = 0.03 %scalar; margins of entire 
    margins_subfig double = 0.03 %scalar or vector; if vector, element index refers to sector of figure; sector split by splitdim;
    splitdim char = 'x' %scalar denoting split dimension, x or y
    splitfrac double = repelem(1/numel(numrows), numel(numrows)-1) %scalar or vector denoting each sector's fraction of splitdim extent; default is even split among num_sectors
end

num_sectors = numel(numrows);

if isempty(margins_fig) %allow empty
    margins_fig = 0.03;
end
if isempty(margins_subfig) %allow empty
    margins_subfig = repelem(0.03, num_sectors);
end
if numel(margins_subfig)==1 && num_sectors~=1 %allow singleton to be repeated to match num_sectors
    margins_subfig = repelem(margins_subfig, num_sectors);
end
if ~isequal(numel(numrows), numel(numcolumns), numel(margins_subfig), numel(splitfrac)+1)
    error("length must be same for numrows, numcolumns, margins_subfig, splitfrac+1")
end


for j = 1:num_sectors
    numsubfigs(j).x = numcolumns(j);
    numsubfigs(j).y = numrows(j);
    splitfracfull(j).x = 1;
    splitfracfull(j).y = 1;
    margins_fig_full(j).x = [margins_fig margins_fig];
    margins_fig_full(j).y = [margins_fig margins_fig];
    if j==1
        margins_fig_full(j).(splitdim) = [margins_fig 0];
    elseif j==num_sectors
        margins_fig_full(j).(splitdim) = [0 margins_fig];
    else
        margins_fig_full(j).(splitdim) = [0 0];
    end
    if j==num_sectors
        splitfracfull(j).(splitdim) = 1-cumsum(splitfrac);
    else
        splitfracfull(j).(splitdim) = splitfrac(j);

    end
end
startpos.x = 0;
startpos.y = 0;

for j = 1:num_sectors

    [ax(j), maxpos] = arrange_subplots_onesector(numsubfigs(j), margins_fig_full(j), margins_subfig(j), splitfracfull(j), startpos);
    startpos.(splitdim) = maxpos.(splitdim);

end

for j = 1:num_sectors
    ax(j).yp = flip(ax(j).yp); %make y order top to bottom
end


end


function [ax, maxpos] = arrange_subplots_onesector(numsubfigs, margins_fig, margins_subfig, splitfrac, startpos)

fn = fieldnames(splitfrac);
for fi = 1:numel(fn)
    [ax.([fn{fi} 'p']), ax.([fn{fi} 'e']), maxpos.(fn{fi})] = arrange_subplots_onedim(numsubfigs.(fn{fi}), margins_fig.(fn{fi}), margins_subfig, splitfrac.(fn{fi}), startpos.(fn{fi}));
end

end


function [position, extent, maxpos] = arrange_subplots_onedim(numsubfigs, margins_fig, margins_subfig, splitfrac, startpos)

minpos = 0+startpos+margins_fig(1);
maxpos = minpos+1*splitfrac-margins_fig(2);

position = linspace( minpos, maxpos, numsubfigs+1 ) ;
position = position(1:end-1); %position including labels (outer position)

extent_with_labels = maxpos - position(end); %extent including labels
extent = extent_with_labels - margins_subfig/2;

end
