
inmin = -1;
inmax = 1;
outmin = -5;
outmax = 5;
pth_save = '~/Documents/genlogtest3.gif';
B = linspace(.1, 2, 10); %slope, 0 is horizontal line
A = [outmin]; %left asymptote value
K = [outmax]; %right asymptote (exactly if C=1, otherwise a function of C, A, K, V)
V = linspace(0, 1, 1 ); %[.2]; %inflection point, 1 is balanced in center; can't be negative, approaches ylim asymptotically
M = linspace(0, 0, 1); %[1]; %x shift, larger and more direct effect than Q
Q = [1];%linspace(1, 1, 1); %[-1.2 -0.8 -.1 0 0.1 0.8 1.2];  %kind of like x shift / when curve starts to rise  (i think this needs to be positive??)
C = [1]; %maybe can force this to be 1, changes right asymptote value, above 1 makes it exponentially closer to lower asymptote, and below eponentially furthe
x = linspace(inmin, inmax, 1000);
genlog(x, B,A,K,V,M,Q,C, 1, pth_save, [inmin inmax], [inmin inmax])


