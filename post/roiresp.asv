    % figure;
    % for ci = 1:size(roi_dff, 1)
    %
    %     subplot(3,1,1)
    %     hist(vec(roi_box(ci,:)), 100);
    %     xlim([0 0.5])
    %
    %     subplot(3,1,2)
    %     hist(vec(roi_nn(ci,:)-1), 100);
    %     xlim([0 0.5])
    %
    %     subplot(3,1,3)
    %     indiest = 1:200;
    %     yyaxis left
    %     plot(roi_box(ci,indiest))
    %     yyaxis right
    %     plot(roi_nn(ci,indiest))
    %     pause(.2)
