function cb = default_cbflags(varargin)

if any(strcmp('all', varargin))

    if any(strcmp('restart', varargin))
        cb.restart.v = [];
        cb.restart.t = [];
    end

    if any(strcmp('get', varargin))
        cb.get.v = [];
        cb.get.i = [];
        cb.get.tstart = [];
        cb.get.tend = [];
    end

    if any(strcmp('tmp', varargin))
        cb.tmp.v = [];
        cb.tmp.i = [];
        cb.tmp.tinds = [];
        cb.tmp.roicen = [];
    end
    
    if any(strcmp('val', varargin))
        cb.val.v = [];
        cb.tmp.v = [];
        cb.val.i = [];
        cb.tmp.i = [];
        cb.val.tinds = [];
        cb.tmp.tinds = [];
        cb.tmp.tstart = [];
        cb.tmp.tend = [];
        cb.val.roicen = [];
        cb.tmp.roicen = [];
    end

    if any(strcmp('delete', varargin))
        cb.delete.roicen = [];
        cb.changed.t = [];
    end

    cb.lab.title = [];

end

end