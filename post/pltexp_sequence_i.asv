
function [ttl, val_imcen_out, val_chanalpha_out, val_imchan_out] = pltexp_sequence_i(user_input, save_buttons, roipixindp, numchan, numplane)

persistent get_c
persistent get_p
persistent tmp_c
persistent tmp_p
persistent tmp_imcen
persistent require_channel_reentry
persistent require_plane_reentry
persistent changed_imcen
persistent subsequence_type
persistent val_imcen_out_tmp
persistent val_chanalpha_out_tmp
persistent val_imchan_out_tmp

chanalpha_inc = 0.05;

context_buttons = {'c'};
quick_buttons = {'uparrow', 'downarrow', 'leftarrow', 'rightarrow'};

ttl = ['PRESSED ' num2str(user_input) ' OUT OF CONTEXT, NOTHING WILL HAPPEN']; %default title, in case not overwritten


if ~isempty(get_c) && all(isstrprop(user_input, 'digit'))

    [tmp_c, ttl] = get_subsequence_digit(tmp_c, user_input);

elseif ~isempty(get_p) && all(isstrprop(user_input, 'digit'))

        [tmp_p, ttl] = get_subsequence_digit(tmp_p, user_input);

elseif isnumeric(user_input) %&& isempty(subsequence_type)

    subsequence_type = 'click';
    tmp_imcen = user_input;
    ttl = ['CLICKED IMAGE VOXEL ' mat2str(vec(tmp_imcen)') ', PRESS DIGIT TO SET NEW IMAGE EDGES'];

elseif any(strcmpi(user_input, context_buttons)) %&& isempty(subsequence_type)

    subsequence_type = 'keyboard';
    if strcmpi(user_input, 'c')
        ttl = ['PRESSED "c", USE DIGITS TO CHOOSE WHICH SINGLE CHANNEL TO ADJUST, OR PRESS NO DIGIT TO MODIFY ALL AVAILABLE CHANNELS'];
        get_c = 1;
        require_channel_reentry = 0;
    elseif strcmpi(user_input, 'p')
        ttl = ['PRESSED "c", USE DIGITS TO CHOOSE WHICH SINGLE CHANNEL TO ADJUST, OR PRESS NO DIGIT TO MODIFY ALL AVAILABLE CHANNELS'];
        get_p = 1;
        require_plane_reentry = 0;
    end

elseif any(strcmpi(user_input, quick_buttons)) % && isempty(subsequence_type)

    if ~ismember(tmp_c, 1:numchan)
        ttl = ['CHANNEL #' num2str(tmp_c) ' DOES NOT EXIST; PRESS c AGAIN AND ENTER DIGIT TO MODIFY ONE CHANNEL, OR ENTER NO DIGIT TO MODIFY ALL AVAILABLE CHANNELS'];
        require_channel_reentry = 1;
    elseif ~ismember(tmp_p, 1:numplane)
        ttl = ['PLANE #' num2str(tmp_p) ' IS OUT OF RANGE FOR STACK WITH ' num2str(numplane) ' PLANES; PRESS p AGAIN AND ENTER DIGIT TO MODIFY ONE PLANE, OR ENTER NO DIGIT TO MODIFY ALL AVAILABLE PLANES'];
        require_plane_reentry = 1;
    else
        if ~isequal(require_channel_reentry, 1) && ~isequal(require_plane_reentry, 1) %without this, empty val_imchan_out_tmp will be read as all channels and arrows can have effect, after the first loop where tmp_c is set to empty; we don't want arrows to work for invalid channel
            if isempty(val_imchan_out_tmp) || ~isempty(tmp_c) || isequal(require_channel_reentry,0) || isequal(require_plane_reentry,0) %these 4 or expressions allows you to use v-arrow or v-c-arrow or c-arrow (after setting v) to change all channels, and v-c-number-arrow and c-number-arrow to change one channel
                val_imchan_out_tmp = tmp_c;
                val_implane_out_tmp = tmp_p;
            end
            [val_chanalpha_out_tmp, ttl] = arrow_subsequence(user_input, chanalpha_inc);
            if isempty(val_imchan_out_tmp) %if it's still empty after being assigned tmp_c, it gets all channels
                val_imchan_out_tmp = 1:numchan;
            end
            if isempty(val_implane_out_tmp) %if it's still empty after being assigned tmp_c, it gets all channels
                val_implane_out_tmp = 1:numplane;
            end
            ttl = [ttl ', PLANE #' regexprep(num2str(val_implane_out_tmp), ' +', ',')]; %in case multiple channels
            ttl = [ttl ', CHANNEL #' regexprep(num2str(val_imchan_out_tmp), ' +', ' and ')]; %in case multiple channels
        end
    end
    get_p = [];
    tmp_p = [];
    get_c = [];
    tmp_c = []; %no need to accumulate digits, tmp_c is for channels so can only be 1 or 2 or empty
    require_channel_reentry = [];
    require_plane_reentry = [];


elseif any(strcmpi(user_input, save_buttons))

    if ~isempty(tmp_imcen) && ~isempty(subsequence_type)

        if strcmpi(user_input, 'n')
            ttl = ['PRESSED "n", CHANGING LIMITS WITH NEW CENTROID'];
            val_imcen_out_tmp = [];
        end
        val_imcen_out_tmp = unique( cat(1, val_imcen_out_tmp, tmp_imcen), 'rows');
        changed_imcen = 1;

    end


    tmp_imcen = [];
    subsequence_type = [];

end


val_imcen_out = val_imcen_out_tmp;
val_chanalpha_out = val_chanalpha_out_tmp;
val_imchan_out = val_imchan_out_tmp;


end



function [out, ttl] = arrow_subsequence(user_input, inc)
if strcmpi(user_input, 'uparrow')
    ttl = ['PRESSED "uparrow", RAISING ALPHA '];
    out = inc;
elseif strcmpi(user_input, 'downarrow')
    ttl = ['PRESSED "downarrow", LOWERING ALPHA '];
    out = -inc;
end
end

function [tmp, ttl] = get_subsequence_digit(tmp, user_input)
tmp = [tmp str2double(user_input)];
tmp = str2double(strrep(num2str(tmp), ' ', ''));
ttl = ['PRESSED ' num2str(tmp) ', CONTINUE ENTERING DIGITS, OR PRESS NON-DIGIT TO USE ' num2str(tmp)];
end

