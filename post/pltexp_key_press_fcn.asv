
function pltexp_uikeypress(hfg, event, varargin)

pth_tmpfiles = varargin{1};

eventkey = event.Key;
eventmod = event.Modifier;

if isstrprop(eventkey, 'digit')
    fid = fopen([pth_tmpfiles 'tmp_ui_control_.bin'], 'w');
    fwrite(fid, str2num(eventkey), 'uint16')
else

    if strcmpi(eventkey, 'escape') 
        fid = fopen([pth_tmpfiles 'tmp_ui_control_.bin'], 'w');
        fwrite(fid, 1, 'uint16');
        fclose('all');
    
    elseif strcmpi(eventkey, 'return') || strcmpi(eventkey, '0')
        fid = fopen([pth_tmpfiles 'tmp_ui_control_.bin'], 'w');
        fwrite(fid, 2, 'uint16');
        fclose('all');

    elseif strcmpi(eventkey, 'v')
        fid = fopen([pth_tmpfiles 'tmp_ui_control_.bin'], 'w');
        fwrite(fid, 3, 'uint16');
        fclose('all');

    elseif strcmpi(eventkey, 'k')
        fid = fopen([pth_tmpfiles 'tmp_ui_control_.bin'], 'w');
        fwrite(fid, 3, 'char');
        fclose('all');

    elseif strcmpi(eventkey, 'i')
        fid = fopen([pth_tmpfiles 'tmp_ui_control_.bin'], 'w');
        fwrite(fid, 4, 'uint16');
        fclose('all');

    elseif strcmpi(eventkey, 't')
        fid = fopen([pth_tmpfiles 'tmp_ui_control_.bin'], 'w');
        fwrite(fid, 5, 'uint16');
        fclose('all');

    elseif strcmpi(eventkey, 'hyphen')
        fid = fopen([pth_tmpfiles 'tmp_ui_control_.bin'], 'w');
        fwrite(fid, 6, 'uint16');
        fclose('all');
    
    elseif strcmpi(eventkey, 'n')
        fid = fopen([pth_tmpfiles 'tmp_ui_control_.bin'], 'w');
        fwrite(fid, 7, 'uint16');
        fclose('all');
    
    elseif strcmpi(eventkey, 'a')
        fid = fopen([pth_tmpfiles 'tmp_ui_control_.bin'], 'w');
        fwrite(fid, 8, 'uint16');
        fclose('all');
    
    elseif strcmpi(eventkey, 'backspace')
        % error("undo not implemented yet")
        fid = fopen([pth_tmpfiles 'tmp_ui_control_.bin'], 'w');
        fwrite(fid, 9, 'uint16');
        fclose('all');

    elseif strcmpi(eventkey, 'downarrow')
        scaleshift = -1;
        if strcmpi(eventmod, 'shift')
            scaleshift = -5;
        end
        fid = fopen([pth_tmpfiles 'tmp_ui_control_.bin'], 'w');
        fwrite(fid, scaleshift, 'uint16')
        fclose('all');

    elseif strcmpi(eventkey, 'uparrow')
        scaleshift = 1;
        if strcmpi(eventmod, 'shift')
            scaleshift = 5;
        end
        fid = fopen([pth_tmpfiles 'tmp_ui_control_.bin'], 'w');
        fwrite(fid, scaleshift, 'uint16')
        fclose('all');

    end

end


end

