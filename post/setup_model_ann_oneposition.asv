
function [lbnd, ubnd, linineq_A, linineq_b, x0, ann, freeformflag] = ...
    setup_model_ann_oneposition(annspec, indv, depv, num_samp_model, dt, num_dim_indvin, padlen_sec)

% in annspec, strlin for linear functions, stract for activation (nonlinear) functions
% strlin 's' and 'd' and 'f' make linear filters (s is monophasic; d is biphasic, formed from derivative of s; f is freeform, can take any shape)
% strlin 'l' skips linear filter stage
% stract 'e' and 'i' make generalized logistic functions (includes sigmoids), with constraints on params controlling slope and horizontal asymptotes
% forcing 'e' to be positive true slope (left horiz asymptote<right horiz asymptote with positive slope param)
% and 'i' to be negative true slope  (left horiz asymptote>right horiz asymptote with positive slope param)
% stract that starts with 'h' makes hot encoded nonlinear function (can take any shape)
% stract 'a' skips activation function stage

%% define time domain for linear filters

tmax = dt*(num_samp_model-1);
t = 0:dt:tmax; %zero-indexed time for filter

fullfac = 1;
tfullmax = tmax*fullfac;
tfull = 0:dt:tfullmax; %zero-indexed time for end-padded filter

padlen = round(padlen_sec/dt);
tmppad = zeros(1, numel(tfull)+padlen*2);
tshiftmax = dt*(numel(tmppad)-1);
tshift = 0:dt:tshiftmax; %zero-indexed time for padded and shifted filter

filtnorm = 1;


%% activation function constants

C = 1; %hard coded param
Q = 1; %hard coded param

%% some useful variables for this function

max_num_fun_per_neuron = max(sum(cellfun(@any, regexp([annspec.strlin(:) annspec.stract(:)], '[^l|a]')), 2));
num_neuron = size(annspec, 1);
minindv = min(indv(:));
maxindv = max(indv(:));
extremeindv = max(abs(indv(:)));
mindepv = min(depv(:));
maxdepv = max(depv(:));
extremedepv = max(abs(depv(:)));
meandepv = mean(depv(:));

%% define all possible params for each artificial neuron (some will not be used, depending on neuron type)

% 3-element vectors below are [lowerbound, upperbound, startpoint]

tau1 = [dt/2, 0.3, dt]; %filter tau, in units of seconds, don't tranform into units of samples since filter is implemented in time not samples
filtshift = [0, 0.75, 0.01];   %filter shift (ie lag, delay, rightward shift of filter) in seconds, implemented with spline interp
filtbias = [-extremedepv, extremedepv, 0.01]; %"y intercept", "bias", added to linear filter output

% old 'd' filter params, for function 'linear_filter_1d_deprecated', now trying derivative of monophasic
% tau2 = [0.1, 2, 0.5]; %fraction by which tau2 is larger than tau1 (better behaved)
% tc = [0, 1, 0.1]; %L1 norm of tau2 filter, redundant with filtnorm somewhat, so make filtnorm constant
% filtnorm = [-inf, inf, 1]; %L1 norm of whole filter (tau1 filter minus tau2 filter, assuming latter is not norm zero )

sigmoid_slope = [0.1, inf, 1];  %force positive, letting left/right asymptotes determine sign without redundancy from slope (no constraint that left must be greater than right)
sigmoid_asympleft = [-extremedepv*2, extremedepv*2, mindepv];
sigmoid_asympright = [-extremedepv*2, extremedepv*2, maxdepv];
sigmoid_inflection = [0, inf, 1]; %must be positive
sigmoid_xshift = [-extremeindv*2, extremeindv*2, mean([minindv maxindv])];  %since filtnorm is forced to be 1, filter output will be on order of indv

hotnonlin_weights = [-extremedepv*2, extremedepv*2, meandepv];

%%


lbnd = [];
ubnd = [];
x0 = [];
linineq_min_difference = 0; %zero allows equality, could try -2*options.ConstraintTolerance instead of zero (why -2, why not just -options.ConstraintTolerance?)
neuron_ind_total = 0;
num_par_running_total = 0;

for ni = 1:num_neuron

    neuron_ind_total = neuron_ind_total + 1;

    if strcmp(annspec.strlin{ni}, 'l') %skips linear filter
        lbnd_lin = [];
        ubnd_lin = [];
        x0_lin = [];
    elseif strcmp(annspec.strlin{ni}, 's') %makes monophasic filter, 2 params
        lbnd_lin = [tau1(1), filtshift(1), filtbias(1)];
        ubnd_lin = [tau1(2), filtshift(2), filtbias(2)];
        x0_lin = [tau1(3), filtshift(3), filtbias(3)];
    elseif strcmp(annspec.strlin{ni}, 'd') %makes biphasic filter, 4 params, ie includes params for 2nd filter (constrained to be slower), subtracted from first
        lbnd_lin = [tau1(1), filtshift(1), filtbias(1)];
        ubnd_lin = [tau1(2), filtshift(2), filtbias(2)];
        x0_lin = [tau1(3), filtshift(3), filtbias(3)];
    elseif strcmp(annspec.strlin{ni}, 'd2') %old approach for d filter, 'd2' specifier currently not supported %makes biphasic filter, 4 params, ie includes params for 2nd filter (constrained to be slower), subtracted from first
        lbnd_lin = [tau1(1), filtshift(1), tau2(1), tc(1)];
        ubnd_lin = [tau1(2), filtshift(2), tau2(2), tc(2)];
        x0_lin = [tau1(3), filtshift(3), tau2(3), tc(3)];
    elseif strcmp(annspec.strlin{ni}, 'f') %freeform filter, can take any shape
        lbnd_lin = -inf(1, num_samp_model);
        ubnd_lin = inf(1, num_samp_model);
        x0_lin = rand(1, num_samp_model);
        x0_lin = x0_lin / norm(vec(x0_lin(:)),1); %L1 norm=1
    end

    ann.actfun{ni} = [];
    if strcmp(annspec.stract{ni}, 'a') || strcmp(annspec.stract{ni}, 'y') %skip activation function
        lbnd_nonlin = [];
        ubnd_nonlin = [];
        x0_nonlin = [];
    elseif any(strcmp(annspec.stract{ni}, {'e', 'i'}))
        ann.actfun{ni} = @static_genlog;
        lbnd_nonlin = [sigmoid_slope(1), sigmoid_asympleft(1), sigmoid_asympright(1), sigmoid_inflection(1), sigmoid_xshift(1)];
        ubnd_nonlin = [sigmoid_slope(2), sigmoid_asympleft(2), sigmoid_asympright(2), sigmoid_inflection(2), sigmoid_xshift(2)];
        x0_nonlin = [sigmoid_slope(3), sigmoid_asympleft(3), sigmoid_asympright(3), sigmoid_inflection(3), sigmoid_xshift(3)];
    elseif startsWith(annspec.stract{ni}, 'h')
        ann = setup_model_onehot(ann, annspec, ni, num_dim_indvin, num_samp_model, num_neuron);
        lbnd_nonlin = ones(1, annspec.numbinhot{ni})*hotnonlin_weights(1);
        ubnd_nonlin = ones(1, annspec.numbinhot{ni})*hotnonlin_weights(2);
        x0_nonlin = ones(1, annspec.numbinhot{ni})*hotnonlin_weights(3);
    end

    num_par_this_neuron = length(x0_lin)+length(x0_nonlin);
    parind_this_neuron = [1:num_par_this_neuron] + num_par_running_total;
    num_par_running_total = num_par_running_total + num_par_this_neuron;
    pind(ni).L = parind_this_neuron(1:length(x0_lin));
    pind(ni).N = parind_this_neuron(length(x0_lin)+1:end);
    if strcmp(annspec.strlin{ni}, 'f')
        pind(ni).Lfree = parind_this_neuron(1:length(x0_lin));
    end

    linineq_A_tmp = zeros(1, num_par_this_neuron);
    if strcmp(annspec.stract{ni}, 'e')  %left asymptote <= right asymptote will make positive slope (assuming slope param constrained positive) but we want strictly less than (right?), so modify linineq_b to not be zero?
        linineq_A_tmp(length(x0_lin)+2) = 1;
        linineq_A_tmp(length(x0_lin)+3) = -1;
    elseif strcmp(annspec.stract{ni}, 'i')  %right asymptote <= left asymptote will make negative slope (assuming slope param constrained positive) but we want strictly less than (right?), so modify linineq_b to not be zero?
        linineq_A_tmp(length(x0_lin)+2) = -1;
        linineq_A_tmp(length(x0_lin)+3) = 1;
    end

    lbnd = [lbnd lbnd_lin lbnd_nonlin];
    ubnd = [ubnd ubnd_lin ubnd_nonlin];
    x0 = [x0 x0_lin x0_nonlin];
    linineq_A(neuron_ind_total, parind_this_neuron) = linineq_A_tmp;
    linineq_b(neuron_ind_total) = 0 + linineq_min_difference;

end


if any(strcmp(annspec.strlin, 'f'))
    freeformflag = 1;
else
    freeformflag = 0;
end

ann.num_neuron = num_neuron;
ann.annspec = annspec;
ann.pind = pind;
ann.max_num_fun_per_neuron = max_num_fun_per_neuron;
ann.linfun = @linear_filter_1d;


%% nested linear filter functions


    function filt = linear_filter_1d(flagdiff, doplots, tau1, shift)


        tmp = tfull./tau1^2.*exp(-tfull./tau1); %t = t-shift does not work for this, so using interp below for shift
        if flagdiff
            tmp = [0 diff(tmp)];
        end

        if doplots
            tmpplot = tmp(1:numel(t));
            tmpplot = tmpplot / norm(tmpplot(:),1) * filtnorm; %normalize by L1
            hfg = figure; hax = axes('Parent', hfg); plot(hax, t, tmpplot); hold on;
        end

        tmppad(:) = 0; %initialized earlier, re-zeroed here each time through this function
        tmppad(padlen+1:end-padlen) = tmp;
        tmppad = spline(tshift+shift,tmppad,tshift);
        if ~flagdiff
            tmppad(tmppad<0) = 0; %hack to remove interp artifacts when filter should be nonnegative
        end
        filt = tmppad(padlen+1:end-padlen);
        filt = filt / norm(filt(:),1) * filtnorm; %normalize by L1
        filt = filt(1:numel(t));
        filt = filt / norm(filt(:),1) * filtnorm; %normalize by L1

        if doplots
            plot(hax, t, filt);
            close(hfg)
        end

    end


%% nested activation functions


    function out = static_genlog(x, varargin)

        if nargin==6
            B = varargin{1};
            A = varargin{2};
            K = varargin{3};
            V = varargin{4};
            M = varargin{5};
        else
            error("currently (temporarily) written to accept 8 inputs")
        end

        out = A + ( (K - A) ./ ( C + Q * exp( -B * (x-M) ) .^ 1/V ) );

    end



end
