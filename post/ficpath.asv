function [posx, posy] = ficpath(velfor, velside, yawAngPos, t, balldia)

%                    tmp = tmp*ball_diameter/2; %convert to mm

                yawAngPos = rad2deg(yawAngPos);
                fwdAngVel = ftData_DAQ.velFor{nTrial};
                slideAngVel = ftData_DAQ.velSide{nTrial};
                circum = 9 * pi; % circumference of ball, in mm
                mmPerDeg = circum / 360; % mm per degree of ball
                zeroedYawAngPos = yawAngPos - yawAngPos(1); 
                xChangePos = (fwdAngVel ./ sampRate) .* sind(zeroedYawAngPos) + (slideAngVel ./ sampRate) .* sind(zeroedYawAngPos + 90);  
                xPos = (cumsum(xChangePos) - xChangePos(1)) .* mmPerDeg;
                yChangePos = (fwdAngVel ./ sampRate) .* cosd(zeroedYawAngPos) + (slideAngVel ./ sampRate) .* cosd(zeroedYawAngPos + 90);
                yPos = (cumsum(yChangePos) - yChangePos(1)) .* mmPerDeg;

circum = balldia * pi; %circumference of ball, in mm
mmPerDeg = circum / 360; % mm per degree of ball
fwdAngVel = velfor/mmPerDeg;
zeroedH = heading - heading(1); % zero heading
time_bin = diff(t);
xChangePos = (fwdAngVel(1:end-1).*time_bin)*sin(zeroedH(1:end-1)) + (velside(1:end-1).*time_bin)*sin(zeroedH(1:end-1)+pi/4);
xPos = (cumsum(xChangePos) - xChangePos(1))*mmPerDeg;
yChangePos = (fwdAngVel(1:end-1)*time_bin)*cos(zeroedH(1:end-1)) + (velside(1:end-1)*time_bin)*cos(zeroedH(1:end-1)+pi/4);
yPos = (cumsum(yChangePos) - yChangePos(1))*mmPerDeg;
posx = cat(1, xPos, xPos(end));
posy = cat(1, yPos, yPos(end));


end


