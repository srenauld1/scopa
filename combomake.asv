function [xout, combos, idx] = combomake(x, numsamp, opt)

% find indices of all combinations of input argument x (combos) along sampling dimension (name-value argument 'dm', currently must be 1st dimension)
% if x is cell, sample along dimension dm
% if single input x, all combos of 3rd dim along dimension dm
% if single input is 1d or 2d, all combos of rows (1d is trivial case of single "combination")
% x can be cell or numeric array; if multiple x, cell cannot contain cells; if single x is cell, it can contain cells at one level of nesting
% idx selects a single combination from all combos and outputs the indexed result; idx is stored as a persistent variable (useful to loop over all combinations)

arguments (Input)
    x % cell or numeric array, if multiple x, none can be nested cells; if single x is cell, can be cell of cells (one level of nesting); if single x is not cell, can be 1d, 2d, or 3d
    numsamp = []
    opt.idx = [] % must input positive integer or empty [] (cannot omit because argument 'x' is repeating, so idx could get assigned x); idx is the index of the combination, same as output idx unless opt.idx is empty, in which case output idx takes stored value from persistent variable idxp
    opt.dm = 1 % sampling dimension; for now, must remain 1
    opt.maxn = 2048 % max number of combos, error if above
    opt.loop = 0 %1 to reset idxp to 0 when you've reached last combo; 
end
arguments (Output)
    xout %one combination, the 'idx' index of 'combos'
    combos % all combinations of indices into dimension dm
    idx % index into combos output as xout, can be different from idx name-value input argument if the latter is empty (not specified), otherwise the same
end
idx = opt.idx;
dm = opt.dm;
maxn = opt.maxn;
loop = opt.loop;


if ~isequal(dm, 1)
    error("for now, dm must be 1 (in future, should support other dm with permute dm into first dimension, then reshape at end)")
end
if ~isempty(idx) && ( ~isnumeric(idx) || ~isscalar(idx) || ~isequal(mod(idx,1), 0) || idx<1 )
    error("name-value argument 'idx' must be empty or a positive integer")
end
if isnumeric(x) && ndims(x)==2 && ~isvector(x) && (isempty(numsamp) || ~isnumeric(numsamp) || ~isscalar(numsamp) || ~isequal(mod(numsamp,1), 0) || numsamp<1 )
    error("optional input argument 'numsamp' must be empty, unless first argument 'x' is a 1d or 2d numeric array, in which case numsamp must be a positive integer")
end
if ~(isnumeric(x) && ndims(x)<3) && ~isempty(numsamp)
    error("optional input argument 'numsamp' must be empty, unless first argument 'x' is a 1d or 2d numeric array, in which case numsamp must be a positive integer")
end

persistent idxp
persistent reset_idxp % in case user passes in nonempty name-value argument idx, then returns to empty, idxp should be reset

if isempty(reset_idxp)
    reset_idxp = 0;
end

try %put whole function in try block so we can reset persistent counter (idxp) if error

    if idxp<1
        error("idxp is less than 1, you may have run it and gotten error; run 'clear combomake, then run combomake again")
    end
    if isempty(idxp)
        idxp = 0;
    end
    if isempty(idx)
        if reset_idxp %user passed in nonempty idx previously, and now idx is empty again . . . 
            idxp = 0; % so reset idexp
            reset_idxp = 0; % and also reset this variable
        end
        idxp = idxp+1;
        idx = idxp;
    else
        idxp = idx;
        reset_idxp = 1; % prepare to reset idxp because user passed in nonempty idx
    end

    if isempty(x)

        numcombos = 1;
        combos = 1;
        xout = x; 

    elseif iscell(x)

        if ~isvector(x)
            error("if x is cell, must be vector of cells (each element is a different variable, to be sampled along dimension 'dm')")
        end
        emptyvar = cellfun(@isempty, x);
        emptyvar_sz = cellfun(@size, x, 'UniformOutput', false);
        emptyvar_c = cellfun(@class, x, 'UniformOutput', false);
        x(emptyvar) = {inf}; %replace empty with inf (dummy value), reverted below to original empty size and class
        numvars = numel(x); %if cell, 2nd dimension of cell is "variables dimension"
        numcombos = prod(cell2mat(cellfun(@(x) size(x,dm), x, 'UniformOutput', false)));
        if numcombos>maxn
            error("numcombos exceeds maxn")
        end
        if idxp>numcombos
            error("idxp is greater than numcombos; you may need to reset persistent variable idxp with command 'clear combomake'")
        end
        tmp = cellfun(@(x) 1:size(x,dm), x, 'UniformOutput', false);
        combos = cell(1, numel(tmp));
        [combos{:}] = ndgrid(tmp{:});
        combos = cellfun(@(x) x(:), combos, 'uniformoutput', false);
        combos = [combos{:}];
        xout = cell(1,numvars);
        for k = 1:numvars
            xout{k} = x{k}(combos(idxp,k),:);
            otherdims = setdiff(1:ndims(x{k}), dm);
            szout = [size(xout{k},dm), size(x{k}, otherdims)];
            xout{k} = reshape(xout{k}, szout);
        end
        for k = 1:numvars
            if emptyvar(k)
                x(k) = {createArray(emptyvar_sz{k},emptyvar_c{k})}; %revert to empty
                xout(k) = {createArray(emptyvar_sz{k},emptyvar_c{k})}; %revert to empty
            end
        end

    else

        if isvector(x) || ismatrix(x)
            if isvector(x) && isempty(numsamp)
                numsamp = 1; %set trivial numsamp to 1 if it's empty and x is vector
            end
            if ismatrix(x) && isempty(numsamp)
                error("if input is matrix you must pass in second argument 'numsamp', number of variables to sample from dimension dm of argument x")
            end
            numvars = size(x,dm); %if 1d or 2d numeric array, sampling dimension is also "variables dimension"
            if numsamp>numvars
                error("input argument 'numsamp' exceeds numvars")
            end
            numcombos = factorial(numvars) / (factorial(numsamp) * factorial(numvars-numsamp));
            if numcombos>maxn
                error("numcombos exceeds maxn")
            end
            combos = combinator(size(x,dm), numsamp, 'p'); %if matrix (or vector, trivially) combos will not have repeat indices, so we do not use combinator argument 'r'
            xout = x(combos(idxp,:),:);
        elseif ndims(x)==3
            numvars = size(x,3); %if 3d numeric array, 3rd dimension "variables dimension"
            numcombos = size(x,dm)^numvars;
            if numcombos>maxn
                error("numcombos exceeds maxn")
            end
            if idxp>numcombos
                error("idxp is greater than numcombos; you may need to rest persistent variable idxp with 'clear combomake'")
            end
            tmp = num2cell(repmat(1:size(x,dm), [numvars 1]), 2);
            combos = cell(1, numel(tmp));
            [combos{:}] = ndgrid(tmp{:});
            combos = cellfun(@(x) x(:), combos, 'uniformoutput', false);
            combos = [combos{:}]; %in 3d array, combos will have repeat indices
            xout = zeros(numvars, size(x, setdiff(1:2, dm)));
            for k = 1:numvars
                xout(k,:) = x(combos(idxp,k),:,k);
            end
        else
            error("if x is numeric (not a cell), it must be 1d, 2d, or 3d")
        end

    end

    if loop && idxp==numcombos
        idxp = []; %reset once we've reached the end (if loop is true)
    end

catch ME

    idxp = idxp-1; %reset idxp since function failed
    error("combomake failed, error message is: " + ME.message + newline)

end

end

