function ts = tsnorm(ts, normall, sampper, memthr)

arguments
    ts
    normall
    sampper
    memthr = 1e9
end

% several normalization methods, input tsin is 2d space x time, single or double precision
% normtype_all is cell array of strings, each string specifies a different
% normalization method, which is applied independently to each roi's timeseries (or pixel's timeseries)
% each normalization string is comprised of 'syllables', which can be concatenated in any order for sequential normalization operations
% syllables are applied in order from left to right
% normalized responses are output in same size as input (NO LONGER saved in struct 'resp' to a field whose name matches the normalization string used to produce them)
% below, xxx, yyy, zzz, and www, are 3-character strings converted to integers, range 0-100 (ie use leading zeros to reach 3 characters for anything under 100)
% valid normalization syllables are:
% 'f' : no normalization
% 'dffuuuvvv' : df/f with or without sliding window, uuu as percentile to compute f0 for each window, vvv as sliding window length in seconds, if vvv is 000 then f0 is computed across the entire timeseries (not a sliding window)
% 'rscxxxyyy' : rescale, sending xxx percentile to 0, yyy percentile to 1,
% 'z' : zscore
% 'nn' : nonnegative (subtract min)
% 'box' : box-cox transformation
% for example

tsclass = class(ts);

if ~iscell(normall)
    normall = {normall};
end

for k = 1:length(normall)

    normtmp = normall{k};
    if ~ischar(normtmp)
        error("normtmp must be char")
    end

    normtmp='dff010dff001000rscrsc001100z'

    while normtmp

        mtch = []; %reset on each loop

        if isempty(mtch)
            pat = '^f'; %starts with 'f', this does nothing
            mtch = regexp(normtmp, pat, 'match');
        end

        if isempty(mtch)
            pat = '^dff\d{3}(\d{3})?'; %starts with 'dff' followed by 3 or 6 digits
            mtch = regexp(normtmp, pat, 'match');
            if isscalar(mtch)
                f0_pct = sscanf(mtch{1}(4:6), '%d');
                if numel(mtch{1})==9
                    wlen = sscanf(mtch{1}(7:9), '%d');
                else
                    wlen = 0;
                end
                if wlen
                    if isempty(sampper)
                        error("sampper (sample period) must not be empty if using a dff window")
                    end
                    wlen = round(wlen / sampper);
                    % f0 = RankOrderFilter(ts, wlen, f0_pct);
                    f0 = rofilt(ts, wlen, f0_pct);
                else
                    f0 = prctile(ts, f0_pct, 2); %static baseline
                end
                ts = (ts - f0) ./ f0; %df/f
            end
        end

        if isempty(mtch)
            pat = '^rsc(\d{6})?'; %starts with 'rsc' followed by 0 or 6 digits
            mtch = regexp(normtmp, pat, 'match');
            if isscalar(mtch)
                if numel(mtch{1})==3
                    bot = 0;
                    top = 100;
                else
                    bot = sscanf(mtch{1}(4:6), '%d');
                    top = sscanf(mtch{1}(7:9), '%d');
                end
                lbnd = prctile(ts, bot, 2);
                ubnd = prctile(ts, top, 2);
                ts = (ts-lbnd)./(ubnd-lbnd); %rescaling to specified percentiles
            end
        end

        if isempty(mtch)
            pat = '^z'; %starts with 'z'
            mtch = regexp(normtmp, pat, 'match');
            if isscalar(mtch)
                if startsWith(tsclass, 'u')
                    error("cannot maintain unigned integer class after z score")
                end
                varsz = whos('ts');
                numseg = ceil(varsz.bytes/memthr);
                if numseg>1 %do zscore (convert to single) in segments to use less ram
                    seglen = ceil(size(ts,2)/numseg);
                    for w = 1:numseg %if integer, do it one frame at a time in case stack is big you want to avoid converting the whole thing at once; it's slower but tolerable and better than crashing ram
                        idx = [1:seglen]+seglen*(w-1);
                        idx(idx>size(ts,2)) = [];
                        if isa(ts, 'single') || isa(ts, 'double')
                            ts(:,idx,:) = zscore(ts(:,idx,:), 1, 2); %2nd arg is 1 to use population not sample
                        else
                            ts(:,idx,:) = vtype(zscore(single(ts(:,idx,:)), 1, 2), tsclass); %2nd arg is 1 to use population not sample
                        end
                    end
                else
                    if isa(ts, 'single') || isa(ts, 'double')
                        ts = zscore(ts, 1, 2); %2nd arg is 1 to use population not sample
                    else
                        ts = vtype(zscore(single(ts), 1, 2), tsclass); %2nd arg is 1 to use population not sample
                    end
                end
            end
        end

        if isempty(mtch)
            pat = '^nn'; %starts with 'nn'
            mtch = regexp(normtmp, pat, 'match');
            if isscalar(mtch)
                ts = ts - min(ts, [], 2) + 1; %nonnegative
            end
        end

        if isempty(mtch)
            pat = '^box'; %starts with 'box'
            mtch = regexp(normtmp, pat, 'match');
            if isscalar(mtch)
                mints = min(ts, [], 2); %boxcox input must be nonnegative
                ts = zeros(size(ts), tsclass); %nan(size(tmp))
                for q = 1:size(ts, 3)
                    for m = 1:size(ts, 1)
                        [ts(m,:,q), ~] = boxcox(permute(ts(m,:,q), [2 1 3]) - mints(m,:,q) + 1); %don't need to permute mints because 2nd dim is singleton, so mints(m,:,q) is scalar
                    end
                end
            end
        end

        if isscalar(mtch) %if there was a match above
            normtmp = regexprep(normtmp, ['^' mtch{1}], ''); %remove patmatch (from beginning only) by replacing with empty char, continue loop until normtmp is empty
        else
            error("there is an invalid normalization syllable")
        end

    end

end

