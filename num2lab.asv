function lab = num2lab(x, opt)

%{

convert real numeric vector into an abbreviated character vector (output 'lab', i.e. label for figures)
name-value argument p:
    if p is nonempty, lab prints to p number of digits after decimal (p=0 prints integers)
    if p is empty, lab prints to highest precision in input x
name-value argument maxn sets max number of elements from x to convert to char in lab
name-value argument delim specifies delimiter between each element in output lab
name-value argument prefix specifies prefix in output lab 
output lab does not necessarily reflect orientation of input vector x, since delimiter can be changed (for example, lab can have comma or space delimiter even when input x is column vector)

TODO: accept non-vector input 
TODO: more complex abbreviation options

%}

arguments
    x  % numeric vector to be converted to char vector (label)
    opt.maxn = 10 %max number elements to print, if numel(x)>maxn, only first and last floor(maxn/2) are included in lab
    opt.delim char = ',' %delimiter for each element in output; must be comma or single space or newline
    opt.prefix char = '' %prefix for output
    opt.p = [] %number of elements to include after decimal; if nonempty, must be nonnegative; 0 to print integers; empty to use max precision in input x
end
maxn = opt.maxn;
delim = opt.delim;
prefix = opt.prefix;
p = opt.p;

if ~ismember(delim,{',', ' ', '\n'})
    error("delim must be comma or single space")
end
if ~isempty(x) && ( ~isvector(x) || ~isnumeric(x) )
    error("x must be numeric vector")
end

if ~isempty(x) && isempty(p)
    if isscalar(x)
        p = max(numel(convertStringsToChars(extractAfter(string(x), '.'))));
    else
        p = max(cellfun(@numel, convertStringsToChars(extractAfter(string(x), '.'))));
    end
end

if isequal(p,0)
    pstr = ['%d' delim];
else
    pstr = ['%.' num2str(p) 'f' delim];
end

if any(mod(x,1)~=0) && isequal(p,0)
    x = round(x);
end

if isempty(x)
    lab = '[]';
elseif numel(x)<=maxn
    tmpprint = sprintf(pstr, x);
    lab = [prefix tmpprint(1:end-1)];
else
    if isequal(x, x(1):x(end))
        lab = [prefix '[' num2str(x(1)) ':' num2str(x(end)) ']'];
    else
        if maxn==1
            tmpprint = sprintf(pstr, x(1));
            lab = [prefix '[' tmpprint '...]'];
        else
            numtmp = floor(maxn/2);
            tmpprint = sprintf(pstr, x(1:numtmp));
            tmpprint2 = sprintf(pstr, x(end-(numtmp-1):end));
            lab = [prefix '[' tmpprint '...' tmpprint2(1:end-1) ']'];
        end
    end
end

