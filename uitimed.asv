function ui = uitimed(msg, waittime)

arguments
    msg
    waittime = 25;
end

fprintf(msg + )

ui = []; 
duration = 0; 

tic; 

while isempty(ui) && (duration < waittime)
    duration = toc; %exclude previous 1 ms
    ui = get(gcf, 'CurrentCharacter');
    pause(0.001);
end

if isempty(ui)
    disp('Timeout!'); 
end
