function mustBeSize(x,varargin)

szx = size(x);
k = find(strcmp(varargin, ':'));
varargin(k) = szx(k);
if ndims(x),numel(varargin)
sz = cell2mat(varargin);
if sz(end)==1
    error("don't specify trailing singleton dimensions in argument validation function mustBeSize")
end
if ~isequal(szx, sz)
    error("must be size " + mat2str(sz))
end

end