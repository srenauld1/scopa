function o = ored_bmp(o)

%reduce bmp options to minimal functional set

if strcmp(o.domtype, 'm') && isfield(o, 'mdl') %if domtydomain type is m (morphological), make empty the options used for f (functional) domain type 
    o.mdl = struct; %rmfield(o, 'mdl');
    o.numangrs = [];
    o.maxangrs = [];
end
