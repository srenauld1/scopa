function scopauser(opt)

arguments
    opt.userid = []
    opt.gittoken = []
    opt.gitbranch = []
    opt.gitusername = []
end
userid = opt.userid;
gittoken = opt.gittoken;
gitbranch = opt.gitbranch;
gitusername = opt.gitusername;

if isempty(userid) || isempty(gittoken) || isempty(gitbranch) || isempty(gitusername)
    error("must pass in the following name-value arguments: scopauser, gittoken, gitbranch, and gitusername")
end

pthscopa = getpathscopa();
pthuser = [pthscopa 'usr.txt'];

tmp = dbstack;
if isscalar(tmp) && strcmp(tmp.file, 'scopauser.m')
    glb(userid = userid);
    glb(gittoken = gittoken);
    glb(gitbranch = gitbranch);
    glb(gitusername = gitusername);
    if isfile(pthuser)
        error(pthuser " already exists, delete it and run scopauser again")
    end
    structsv(pthuser, opt, overwrite=1, readonly=1);
else
    error("you must run scopauser from command line")
end