function sout = structfill(sin, sdf, fnxtra, fnnest)

%{

recursively fill struct sin with any missing default fields listed in struct sdf; structs can be nested and nonscalar
sin and sout can be nonscalar, but sdf must be scalar
  if field is in both sin and sdf, assign to sout the value in sin; 
  if field is only in sdf, assign to sout the value in sdf; 
  if field in sin doesn't exist in sdf, error
  any field in sin with name listed in optional input fnxtra are ignored (kept in output) 
optional input fnnest can nest substructs into new structs

%}

arguments
    sin % struct to be filled with any fields that appear in sdf but not in sin
    sdf % struct holding all valid fields ('sdf' denotes 'struct defaults')
    fnxtra = [] % fieldnames that are not in sdf, but are allowed to be in sin
    fnnest = [] % fieldnames to nest contents of sin's top-level structs into (if fnnest = c, sin.a.b becomes sin.a.c.b)
end


%%%% CHECK/FORMAT INPUTS %%%%

if numel(sdf)>1
    error("sdf must be scalar structure")
end
if ~iscell(fnnest)
    fnnest = {fnnest};
end
if isempty(cell2mat(fnnest))
    fnnest = {}; %make it an empty cell, to be sure
end
if ~iscell(fnxtra)
    fnxtra = {fnxtra};
end
if isempty(cell2mat(fnxtra))
    fnxtra = {}; %make it an empty cell, to be sure
end
% fnxtra = cat(2, fnxtra, 'tg');
if any(ismember(fnxtra, fnnest))
    error("fnxtra and fnnest cannot have any elements in common")
end
if any(ismember(fnxtra, fieldnames(sdf)))
    error("fnxtra cannot have any elements in common with sdf fieldnames")
end
if any(ismember(fnnest, fieldnames(sdf)))
    error("fnnest cannot have any elements in common with sdf fieldnames")
end

%%%% BEFORE ENTERING STRUCTFILL_RECURSE, COPY ALL DEFAULTS FOR TOP LEVEL FIELDS IN SIN %%%

if isempty(fieldnames(sin))
    sout = sdf;
else
    fn1 = fieldnames(sin);
    fn1 = fn1(~ismember(fn1, fnxtra));
    for k = 1:numel(fn1)
        fin1 = fn1{k};
        % if ~isfield(sdf, fin1)
        %     error(sprintf("you input sin." + fin1 + ", but sdf." + fin1 + " does not exist"))
        % end
        if isstruct(sin.(fin1))
            if isempty(fnnest)
                if all(ismember(fieldnames(sin.(fin1)), fnxtra)) %skip if all fields belong to fnxtra
                    sout.(fin1) = sin.(fin1);
                else
                    sout.(fin1) = sdf.(fin1);
                end
                sout.(fin1) = structfill_recurse(sin.(fin1), sout.(fin1), fin1);
            else
                fn2 = fieldnames(sin.(fin1));
                fnxtra_matched = fn2(ismember(fn2, fnxtra));
                for w = 1:numel(fnxtra_matched) %remove fnxtra from current sin, then create sout, then put fnxtra back in sout (any fnxtra are unmodified within structfill_recurse)
                    sxtra_hold.(fnxtra_matched{w}) = sin.(fin1).(fnxtra_matched{w});
                    sin.(fin1) = rmfield(sin.(fin1), fnxtra_matched{w});
                end
                for w = 1:numel(fnnest)
                    sout.(fin1).(fnnest{w}) = sdf.(fin1);
                    sout.(fin1).(fnnest{w}) = structfill_recurse(sin.(fin1), sout.(fin1).(fnnest{w}), fin1);
                end
                for w = 1:numel(fnxtra_matched) %add fnxtra back to sout
                    sout.(fin1).(fnxtra_matched{w}) = sxtra_hold.(fnxtra_matched{w});
                end
            end
        else
            if isfield(sdf, fin1)
            sout.(fin1) = sin.(fin1); %update
            else

            end
        end
    end
end


    function sout = structfill_recurse(sin, sout, fnparent)

        num_s_in = numel(sin);
        num_s_original = numel(sout);
        fn_sin = fieldnames(sin);

        if num_s_in>1
            if isequal(num_s_original, 1)
                sout = repelem(sout, num_s_in);
            elseif num_s_original~=num_s_in
                error("sdf must be scalar struct, or match length of sin")
            end

            %for nonscalar struct, find fields that are struct in one index but empty in another (ie not specified) and make them struct so they appear in output tmp, then assign tmp to sout
            yesstruct = cellfun(@isstruct, struct2cell(vec(sin)));
            notstable = ~all(isequal(yesstruct, yesstruct(:,1)), 2);
            for idx_sin = 1:num_s_in
                for q = 1:numel(fn_sin) %don't make this index k or w because this function is nested and k and w is used above
                    fin2 = fn_sin{q};
                    if isequal(yesstruct(q,idx_sin), 0) && isequal(notstable(q), 1)
                        sin(idx_sin).(fin2) = struct;
                    end
                end
            end
            for idx_sin = num_s_in:-1:1 %increment backward to preallocate
                tmp(idx_sin) = structfill_recurse(sin(idx_sin), sout(idx_sin), fnparent);
            end
            sout = reshape(tmp, size(sin));
        else
            for q = 1:numel(fn_sin) %don't make this index k or w because this function is nested and k and w is used above
                fin2 = fn_sin{q};
                if isfield(sout, fin2)
                    if isstruct(sin.(fin2))
                        fntmp = fieldnames(sin.(fin2));
                        if all(ismember(fntmp, 'tg')) %isfield(sin.(fn_sin{u}), 'tg')%if it'sin struct tg, don't update anything within
                            sout.(fin2) = sin.(fin2);
                        else
                            if ~isstruct(sout.(fin2)) && ~isobject(sout.(fin2)) %struct can refer to object not struct
                                error(sprintf(fin2 + " does not exist in default struct sdf"))
                            else
                                sout.(fin2) = structfill_recurse(sin.(fin2), sout.(fin2), fin2);
                            end
                        end
                    else
                        if ~isempty(sin.(fin2)) %in case we're in an index of nonscalar struct where sin wasn't specified
                            sout.(fin2) = sin.(fin2); %update
                        end
                    end
                elseif ismember(fin2, fnxtra)
                    sout.(fin2) = sin.(fin2); %allow fields not in sdf if in fnextra
                else
                    if isstruct(sin.(fin2))
                        if isfield(sdf, fin2) %if it's in sdf (but not sout)
                            sout.(fin2) = structfill_recurse(sin.(fin2), sdf.(fin2), fin2); %if it's in a struct (but not a fnnest)
                        else
                            error(sprintf("neither " + fin2 + " nor " + [fnparent '.' fin2] + " exist in default struct sdf"))
                        end
                    else
                        error(sprintf([fnparent '.' fin2] + " does not exist in default struct sdf"))
                    end
                end
            end
        end

    end


end
